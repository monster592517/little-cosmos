{
  "name": "little-cosmos",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "小小宇宙：网页版全宇宙仿真（太阳系到可观测宇宙六个尺度层级 + 真实星历位置 + 全天体 3D 建模 + 论文四源直达与中文翻译）",
  "scripts": {
    "start": "node server/server.mjs",
    "selfcheck": "node tools/selfcheck.mjs",
    "check:selfcheck": "node tools/check-selfcheck.mjs",
    "check:anchors": "node tools/check-doc-anchors.mjs --selftest",
    "check:refs": "node tools/check-refs.mjs --selftest",
    "migrate:workspace": "node tools/migrate-workspace-rename.mjs",
    "migrate:workspace:self": "node tools/migrate-workspace-rename.mjs --selftest",
    "test": "node tools/smoke-test.mjs",
    "verify": "node tools/verify-ephemeris.mjs",
    "fetch": "node tools/fetch-assets.mjs",
    "build:data": "node tools/build-data.mjs",
    "check:scales": "py -3.13 -X utf8 tools/check-scales.py",
    "check:macro": "py -3.13 -X utf8 tools/check-macro.py",
    "check:macro:self": "py -3.13 -X utf8 tools/check-macro.py --selftest",
    "check:catalog": "py -3.13 -X utf8 tools/check-catalog.py",
    "check:model": "node tools/model-probe.mjs --human",
    "check:model:self": "node tools/model-probe.mjs --selftest",
    "check:bloom": "node tools/check-bloom-kernel.mjs --selftest",
    "diag:levels": "node tools/diag-levels.mjs",
    "mem": "node tools/mem-probe.mjs",
    "gpu": "node tools/gpu-preference.mjs",
    "gpu:apply": "node tools/gpu-preference.mjs --apply",
    "gpu:revert": "node tools/gpu-preference.mjs --revert",
    "perf": "py -3.13 -X utf8 tools/perf-probe.py",
    "perf:full": "py -3.13 -X utf8 tools/perf-probe.py --gpu=hp --all-levels --label-cost",
    "textures": "node tools/check-textures.mjs",
    "textures:self": "node tools/check-textures.mjs --selftest",
    "build:textures": "py -3.13 -X utf8 tools/build-textures.py",
    "check:datacenter": "py -3.13 -X utf8 tools/check-datacenter.py",
    "check:spectra": "node tools/check-spectra.mjs",
    "check:sun": "node tools/check-sun-color.mjs",
    "check:colors": "node tools/check-body-colors.mjs",
    "check:colors:verbose": "node tools/check-body-colors.mjs --verbose",
    "check:colors:fix": "node tools/apply-true-colors.mjs && node tools/apply-true-colors-tables.mjs",
    "check:photometry": "node tools/check-photometry.mjs",
    "check:localgroup": "node tools/check-localgroup.mjs --selftest",
    "check:scale-rings": "node tools/check-scale-rings.mjs --selftest",
    "check:mw-texture": "node tools/check-mw-texture.mjs --selftest",
    "check:offline": "py -3.13 -X utf8 tools/check-offline.py",
    "check:occlusion": "node tools/check-occlusion-args.mjs --selftest",
    "perf:level": "py -3.13 -X utf8 tools/probe-universe-perf.py --gpu=hp",
    "check:inject": "node tools/selftest-injections.mjs",
    "check:inject:list": "node tools/selftest-injections.mjs --list",
    "colors:moons": "node tools/apply-irregular-moon-colors.mjs",
    "colors:moons:dry": "node tools/apply-irregular-moon-colors.mjs --dry",
    "colors:dwarfs": "node tools/apply-dwarf-colors.mjs",
    "colors:dwarfs:dry": "node tools/apply-dwarf-colors.mjs --dry",
    "colors:dwarfs:verify": "node tools/apply-dwarf-colors.mjs --verify",
    "fetch:mboss": "node tools/fetch-mboss.mjs",
    "shot": "py -3.13 -X utf8 tools/shot.py",
    "check:textures-content": "py -3.13 -X utf8 tools/check-texture-content.py",
    "probe:galaxy": "py -3.13 -X utf8 tools/probe-galaxy-visual.py",
    "probe:galaxy:fast": "py -3.13 -X utf8 tools/probe-galaxy-visual.py --no-ablate",
    "probe:pipeline": "py -3.13 -X utf8 tools/probe-render-pipeline.py",
    "probe:localgroup": "py -3.13 -X utf8 tools/probe-localgroup.py",
    "probe:sun-mark": "py -3.13 -X utf8 tools/probe-sun-mark.py",
    "probe:orbits": "py -3.13 -X utf8 tools/probe-orbits-switch.py",
    "dump:mw-texture": "py -3.13 -X utf8 tools/dump-mw-texture.py",
    "analyze:mw-texture": "py -3.13 -X utf8 tools/analyze-mw-texture.py",
    "diag:lg-size": "py -3.13 -X utf8 tools/diag-lg-disc-size.py",
    "shot:view": "py -3.13 -X utf8 tools/shot-view.py",
    "check:aces": "py -3.13 -X utf8 tools/check-aces-reimpl.py",
    "check:aces:ref": "node tools/aces-ref.mjs",
    "shortcut": "node tools/install-shortcut.mjs",
    "check:shortcut": "node tools/install-shortcut.mjs --check",
    "prune:trash": "node tools/prune-trash.mjs",
    "prune:trash:apply": "node tools/prune-trash.mjs --apply",
    "clean:strays": "node tools/clean-strays.mjs",
    "clean:strays:apply": "node tools/clean-strays.mjs --apply",
    "dump:log": "node tools/dump-log.mjs",
    "package": "node tools/package.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.180.0"
  }
}
